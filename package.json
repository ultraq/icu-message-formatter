{
	"name": "@ultraq/icu-message-formatter",
	"version": "0.16.0-beta.2",
	"description": "Format ICU message syntax strings from supplied parameters and your own configurable types",
	"author": "Emanuel Rabina <emanuelrabina@gmail.com> (http://www.ultraq.net.nz/)",
	"license": "Apache-2.0",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ultraq/icu-message-formatter.git"
	},
	"keywords": [
		"icu",
		"message",
		"format",
		"intl",
		"i18n"
	],
	"type": "module",
	"exports": {
		"types": "./dist/IcuMessageFormatter.d.ts",
		"default": "./dist/IcuMessageFormatter.js"
	},
	"files": [
		"dist",
		"CHANGELOG.md"
	],
	"sideEffects": false,
	"scripts": {
		"lint": "eslint \"**/*.ts\"",
		"test": "vitest",
		"build": "npm run build:dist && npm run build:browser",
		"build:dist": "tsc",
		"build:browser": "rollup --config rollup.config.browser.js",
		"typecheck": "attw --pack . --profile esm-only",
		"prepublishOnly": "npm run build"
	},
	"devDependencies": {
		"@arethetypeswrong/cli": "^0.18.5",
		"@eslint/js": "^10.0.1",
		"@rollup/plugin-node-resolve": "^16.0.3",
		"@rollup/plugin-terser": "^1.0.2",
		"@rollup/plugin-typescript": "^12.3.1",
		"@tsconfig/node-lts": "^26.0.1",
		"@tsconfig/node-ts": "^23.6.5",
		"@types/node": "^26.6.6",
		"@vitest/coverage-v8": "^5.1.0",
		"eslint": "^10.15.0",
		"eslint-config-ultraq": "^5.0.0-beta.1",
		"eslint-import-resolver-typescript": "^4.4.5",
		"globals": "^17.14.0",
		"memoize": "^11.0.0",
		"rollup": "^4.68.3",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.2",
		"vitest": "^5.1.0"
	},
	"engines": {
		"node": ">=22"
	}
}
